# Modèle : install.sh remplace GYNA_BRIDGE_HOST par le nom d'hôte du pont.
# Seul le pont est exposé ; hermes serve et le MCP restent sur 127.0.0.1.
GYNA_BRIDGE_HOST {
	reverse_proxy 127.0.0.1:8790 {
		# Streaming SSE : pas de mise en tampon
		flush_interval -1
		transport http {
			read_timeout 20m
		}
	}
	request_body {
		max_size 256KB
	}
}
