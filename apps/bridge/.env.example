PORT=8790
HOST=127.0.0.1
# Même valeur que BRIDGE_SECRET dans l'app
BRIDGE_SECRET=
# hermes serve, en local sur le VPS
HERMES_WS_URL=ws://127.0.0.1:9119/api/ws
# Jeton local de hermes serve (mode non protégé, écoute sur 127.0.0.1 uniquement)
HERMES_TOKEN=
# Profil Hermes dédié à Gyna
HERMES_PROFILE=gyna
# Rappel de fin de tour vers l'app
APP_CALLBACK_URL=https://<app>.vercel.app/api/bridge/turn-complete
DATA_DIR=/var/lib/gyna-bridge
TURN_TIMEOUT_MS=900000
