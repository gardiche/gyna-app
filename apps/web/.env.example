# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Côté serveur uniquement : webhooks du pont, de Telegram et de Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'app (liens magiques, boutons Telegram)
NEXT_PUBLIC_APP_URL=https://gyna.alpact.fr

# --- Pont Gyna (VPS) ---
BRIDGE_URL=https://gyna-bridge.alpact.fr
# Même valeur que BRIDGE_SECRET sur le VPS : openssl rand -hex 32
BRIDGE_SECRET=

# --- Jeton de mission : même valeur que MISSION_JWT_SECRET du serveur MCP ---
MISSION_JWT_SECRET=

# Modèle proposé par défaut si Hermes ne renvoie pas sa liste
DEFAULT_MODEL=anthropic/claude-sonnet-5
DEFAULT_PROVIDER=custom

# --- Telegram (facultatif) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# openssl rand -hex 24, à passer aussi à setWebhook (secret_token)
TELEGRAM_WEBHOOK_SECRET=
# Secret du Database Webhook Supabase vers /api/hooks/approval-created
APP_HOOKS_SECRET=
