PORT=8791
HOST=127.0.0.1
# Rôle gyna_mcp, via le pooler Supabase (Project Settings > Database > Connection string, mode Transaction)
DATABASE_URL=postgresql://gyna_mcp.<ref>:<mot de passe>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
# Même valeur que MISSION_JWT_SECRET dans l'app
MISSION_JWT_SECRET=
# Jeton exigé de Hermes dans l'en-tête Authorization (Bearer)
MCP_ACCESS_TOKEN=
